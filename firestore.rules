rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /daily_reports/{reportId} {
      allow read, write: if true;
    }
    match /farm_settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
